<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Basic metadata -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Launch screen — REQUIRED for modern (non-legacy) window sizing.
         Debug session `front-camera-preview-black` round 5 / Bug A: without a
         `UILaunchScreen` (or a launch storyboard) iOS runs the app in a legacy
         compatibility canvas of 320×480 — the `UIWindowScene` never receives the
         real device geometry, so `UIWindow(windowScene:)` and every VC pushed
         into it are 320×480 on a 393×852 device. An empty `UILaunchScreen` dict
         opts the app into the modern launch path; the window then fills the
         screen on all iPhone + iPad sizes. AppLaunchConfigurationTests asserts
         this key's presence so it cannot be silently dropped. -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- iOS 17 / iPhone + iPad -->
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Scene manifest — UIKit scene lifecycle (Plan 05 wires SceneDelegate class name) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- GEO-01 / D-20 / Phase 3 Plan 08: location permission rationale.
         CLLocationManager.requestWhenInUseAuthorization crashes without this key.
         Copy mentions "United States" per product spec + App Store reviewer
         expectation; CountryGateTests.infoPlistHasUsageDescription asserts both. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Validation Ledger uses your location at sign-in to verify you're in the United States, our service area.</string>

    <!-- Biometric app-lock: BiometricService / BiometricLockViewController / SessionLockService
         use LAContext biometric policy → Face ID. Accessing Face ID on a physical device
         crashes the app without this key — the simulator has no biometric hardware so it
         never surfaced until device CI ran on iPhone 16.
         BiometricServiceTests.infoPlistHasFaceIDUsageDescription asserts its presence. -->
    <key>NSFaceIDUsageDescription</key>
    <string>Validation Ledger uses Face ID to unlock the app and authorize sensitive actions, keeping your verified identity secure on this device.</string>

    <!-- Phase 5 KYC capture pipeline: CameraSession / CameraPermissionViewController open an
         AVCaptureSession for the selfie, driver's-license, and vehicle photo steps.
         AVCaptureDevice video access traps the app at runtime without this key — the KYC
         capture flow crashed on "Get started" the instant it reached the camera.
         CameraUsageDescriptionTests.infoPlistHasCameraUsageDescription asserts its presence. -->
    <key>NSCameraUsageDescription</key>
    <string>Validation Ledger uses the camera to capture your selfie, driver's license, and vehicle photos so we can verify your identity for the freight network.</string>

    <!-- UPL-05 / Phase 5: BGTaskScheduler registration for the resumable upload-continuation
         task. BGTaskScheduler.register(forTaskWithIdentifier:) traps at runtime unless the
         identifier is declared in BGTaskSchedulerPermittedIdentifiers, and the OS will not
         run the task without the `processing` background mode. The identifier mirrors the
         bundle id namespace (RESEARCH Pattern 6 / Runtime State Inventory). -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.maldin.validationLedger.kyc-upload</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>processing</string>
    </array>

    <!-- SEC-02: App Transport Security — strict, no exceptions -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsArbitraryLoadsForMedia</key>
        <false/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <false/>
        <!-- SEC-02: zero exception-domain entries — strict ATS with no bypass. -->
    </dict>
</dict>
</plist>
